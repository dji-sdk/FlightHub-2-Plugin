{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dji.com/schemas/fh2-plugin/manifest.schema.json",
  "title": "FH2 Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "entry", "extensions"],
  "definitions": {
    "pluginLocalId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*$"
    }
  },
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "构建产物专有：由 Toolchain 写入，源 Manifest 中出现即构建失败"
    },
    "id": { "type": "string", "pattern": "^(official|exp)_[a-z0-9]+([_-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "properties": { "platform": { "type": "string" } },
      "description": "构建产物专有：由 Toolchain 写入"
    },
    "entry": { "type": "string", "pattern": "^\\./" },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "platform:http",
          "platform:events",
          "platform:websocket",
          "platform:storage",
          "platform:navigation",
          "platform:location",
          "platform:wpmz",
          "platform:audio",
          "platform:clipboard",
          "platform:notification",
          "platform:dialog",
          "platform:map",
          "platform:wayline-preview",
          "platform:object-upload",
          "platform:devices",
          "cockpit:context",
          "cockpit:camera",
          "cockpit:telemetry",
          "cockpit:detection",
          "cockpit:ai-config",
          "cockpit:scene-geometry",
          "cockpit:live-pointer",
          "cockpit:flight-control",
          "cockpit:gimbal",
          "cockpit:hotkeys",
          "cockpit:smart-track",
          "cockpit:flight-task",
          "project:context",
          "plan:form-context"
        ]
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "point"],
        "properties": {
          "id": { "$ref": "#/definitions/pluginLocalId" },
          "point": {
            "type": "string",
            "enum": [
              "cockpit.ui.toolbar-actions",
              "cockpit.ui.menubar",
              "cockpit.ui.live-overlay",
              "cockpit.ui.left-bottom-panels",
              "cockpit.ui.left-panel",
              "cockpit.ui.sublive-tab",
              "cockpit.ui.flight-actions",
              "cockpit.ui.live-context-menu",
              "plan.form-extensions",
              "project.sidebar-actions",
              "message.alert-popups"
            ]
          }
        },
        "anyOf": [
          {
            "properties": {
              "point": { "const": "cockpit.ui.toolbar-actions" },
              "anchor": { "enum": ["footer-toolbar", "footer-toolbar:before-ai"] }
            }
          },
          { "properties": { "point": { "const": "cockpit.ui.menubar" } } },
          {
            "required": ["overlayLevel"],
            "properties": {
              "point": { "const": "cockpit.ui.live-overlay" },
              "stream": { "enum": ["DronePayload", "DronePayloadSide", "Fpv", "Dock", "Assistant", "LensType"] },
              "overlayLevel": { "enum": ["normal", "top"] }
            }
          },
          { "properties": { "point": { "const": "cockpit.ui.left-bottom-panels" } } },
          { "properties": { "point": { "const": "cockpit.ui.left-panel" } } },
          { "properties": { "point": { "const": "cockpit.ui.sublive-tab" } } },
          {
            "properties": {
              "point": { "const": "cockpit.ui.flight-actions" },
              "anchor": { "enum": ["flight-actions", "flight-actions:after-return-home"] }
            }
          },
          { "properties": { "point": { "const": "cockpit.ui.live-context-menu" } } },
          {
            "properties": {
              "point": { "const": "plan.form-extensions" },
              "anchor": { "enum": ["form-end", "task-strategy:after"] },
              "planType": { "enum": ["all", "normal", "atob", "manual"] }
            }
          },
          {
            "properties": {
              "point": { "const": "project.sidebar-actions" },
              "path": { "type": "string" },
              "position": { "type": "number" }
            }
          },
          { "properties": { "point": { "const": "message.alert-popups" } } }
        ]
      }
    },
    "views": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/pluginLocalId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry"],
        "properties": {
          "entry": { "type": "string", "pattern": "^\\./" },
          "styles": { "type": "array", "items": { "type": "string", "pattern": "^\\./" } }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "src"],
            "properties": {
              "id": { "$ref": "#/definitions/pluginLocalId" },
              "src": { "type": "string", "pattern": "^\\./" }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "default", "label"],
        "properties": {
          "type": { "enum": ["boolean", "number", "string"] },
          "default": {},
          "label": { "type": "string" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "enum": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "buildInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdkVersion", "toolchainVersion"],
      "properties": {
        "sdkVersion": { "type": "string" },
        "toolchainVersion": { "type": "string" }
      },
      "description": "构建产物专有：由 Toolchain 写入"
    }
  }
}
